{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "CLAREVO_WIDGET": "1"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "distribution": "store",
        "image": "latest"
      }
    },
    "preview-sem-widget": {
      "extends": "preview",
      "env": {
        "CLAREVO_WIDGET": "0"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "CLAREVO_WIDGET": "1"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "language": "pt-BR"
      }
    }
  }
}
