# Copie para .env e preencha (ver docs/05_SUPABASE.md). Sem estes valores, o app roda em demonstração.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Endereço do site público (D-064, docs/07 e docs/16). Deixe vazio até o site estar publicado: sem ele, os links para os Termos de uso e a
# Política de privacidade (cadastro e Conta) não aparecem. Exemplo: https://clarevo-site.pages.dev
EXPO_PUBLIC_SITE_URL=
